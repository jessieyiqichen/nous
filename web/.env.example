# Nous web (Next.js) environment variables.
# Copy to .env.local and fill in. PLACEHOLDERS ONLY — never commit real secrets.
# Every var below is read somewhere in web/ or bots/ (verified via grep for process.env.*).

# ── LLM provider (DeepSeek, OpenAI-compatible) ──
# The web/bot LLM client is DeepSeek, NOT Anthropic. See web/lib/deepseek.ts.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Per-user data store (twin-store) ──
# If TWIN_DB_PATH is set, twin-store uses local SQLite at that path.
# Otherwise it falls back to Supabase (service-role, see below).
TWIN_DB_PATH=./data/twin.db
# Shared secret for server-to-server twin feedback/handle calls.
TWIN_FEEDBACK_KEY=change-me
# Base URL the Feishu bot / Mac helper POST to (e.g. http://localhost:3999).
TWIN_BASE_URL=http://localhost:3999

# ── Supabase (used by twin-store when TWIN_DB_PATH is unset) ──
# Supabase project settings → API. Service role key is server-only, never client.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Pilot study (/pilot) ──
# Comma-separated invite codes; one code per subject (code == subject id).
PILOT_CODES=P01,P02,P03,P04,P05

# ── Core data location ──
# Directory where per-subject cognitive data lives (used by some API routes).
NOUS_SUBJECT_DIR=./data/subjects

# ── Feishu (Lark) bot (bots/feishu-twin) ──
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_ENCRYPT_KEY=...
FEISHU_VERIFICATION_TOKEN=...

# ── Optional ──
# Vercel Blob (fallback storage when Supabase is unavailable; not needed locally).
# BLOB_READ_WRITE_TOKEN=vercel_blob_...
