# ── 必需 ──
# Anthropic API key（服务端调用，绝不进客户端）
ANTHROPIC_API_KEY=sk-ant-...

# ── 内测（/pilot）──
# 邀请码列表，逗号分隔；一个被试一个码，码即编号
PILOT_CODES=P01,P02,P03,P04,P05

# 数据持久化：Supabase 项目设置 → API 里复制
# 建表 SQL 见 ../supabase/schema.sql（在 Supabase SQL Editor 执行一次）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── 可选 ──
# Vercel Blob（Supabase 不可用时的第二存储；本地开发不需要）
# BLOB_READ_WRITE_TOKEN=vercel_blob_...
